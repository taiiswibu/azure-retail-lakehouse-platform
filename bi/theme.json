$themeJson = @'
{
  "name": "RetailLakehouseTheme",
  "dataColors": [
    "#0284C7",
    "#0EA5E9",
    "#10B981",
    "#F59E0B",
    "#EF4444",
    "#6366F1",
    "#8B5CF6",
    "#EC4899"
  ],
  "background": "#FFFFFF",
  "foreground": "#0F172A",
  "tableAccent": "#0284C7"
}
'@

# Ghi file chuẩn UTF8 không kèm BOM để Power BI đọc chuẩn xác
[System.IO.File]::WriteAllText("$PWD\retail_lakehouse_theme.json", $themeJson, [System.Text.UTF8Encoding]::new($false))
Write-Host "Đã xuất file retail_lakehouse_theme.json chuẩn!"