{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/contracts/order.schema.json",
  "title": "ERP Order",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "order_id", "customer_id", "order_ts", "status", "channel",
    "subtotal", "discount_amount", "shipping_fee", "total_amount", "updated_at"
  ],
  "properties": {
    "order_id": {"type": "string", "format": "uuid"},
    "customer_id": {"type": "string", "format": "uuid"},
    "order_ts": {"type": "string", "format": "date-time"},
    "status": {"type": "string", "enum": ["pending", "paid", "shipped", "completed", "cancelled", "refunded"]},
    "channel": {"type": "string", "enum": ["web", "mobile", "marketplace", "store"]},
    "payment_method": {"type": "string"},
    "shipping_city": {"type": "string"},
    "subtotal": {"type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$"},
    "discount_amount": {"type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$"},
    "shipping_fee": {"type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$"},
    "total_amount": {"type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$"},
    "updated_at": {"type": "string", "format": "date-time"}
  }
}

